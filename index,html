<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>[YOUR AGENCY NAME] | Independent Cruise Travel Agency</title>
<meta name="description" content="Independent cruise experts on the phone. Flight + cruise packages, weddings and groups, senior and military rates. Call [PHONE DISPLAY].">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --night:#0B2238;
  --harbor:#0F2A44;
  --deep:#081A2B;
  --lagoon:#1C8C88;
  --lagoon-soft:#E1F2F0;
  --brass:#E9B44C;
  --brass-hi:#F4C96E;
  --foam:#F5F9FA;
  --ink:#3E4F60;
  --muted:#6B7C8C;
  --line:#D6E2E6;
  --display:"Bricolage Grotesque",Georgia,serif;
  --body:"Figtree",-apple-system,"Segoe UI",Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);color:var(--harbor);background:var(--foam);line-height:1.6;font-size:17px;padding-bottom:84px}
a{color:inherit}
img{max-width:100%;display:block}
:focus-visible{outline:3px solid var(--brass);outline-offset:3px;border-radius:6px}
.wrap{max-width:1160px;margin:0 auto;padding:0 24px}
.ico{width:20px;height:20px;flex:none}
h2{font-family:var(--display);font-weight:800;font-size:clamp(30px,3.6vw,44px);line-height:1.06;letter-spacing:-.02em}
section{padding:96px 0}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:32px;margin-bottom:40px}
.section-head p{color:var(--ink);max-width:44ch}

/* top bar */
.top{position:absolute;top:0;left:0;right:0;z-index:5}
.top .wrap{display:flex;justify-content:space-between;align-items:center;padding-top:22px;padding-bottom:22px}
.brand{font-family:var(--display);font-weight:800;font-size:23px;color:#fff;text-decoration:none;letter-spacing:-.01em;line-height:1.1}
.brand small{display:block;font-family:var(--body);font-weight:500;font-size:12px;color:#A9C6D8;letter-spacing:0;margin-top:2px}
.top-call{display:flex;align-items:center;gap:10px;color:#fff;text-decoration:none;font-weight:600;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);padding:10px 16px;border-radius:999px;backdrop-filter:blur(6px)}
.top-call:hover{background:rgba(255,255,255,.18)}
.top-call span{color:var(--brass-hi)}

/* hero */
.hero{position:relative;overflow:hidden;background:var(--night);color:#fff;min-height:720px}
.scene{position:absolute;inset:0;width:100%;height:100%}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;padding-top:150px;padding-bottom:190px}
.status{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:600;background:rgba(8,26,43,.55);border:1px solid rgba(255,255,255,.18);padding:7px 14px 7px 12px;border-radius:999px;margin-bottom:22px}
.dot{width:9px;height:9px;border-radius:50%;background:#4ADE80;box-shadow:0 0 0 4px rgba(74,222,128,.22)}
.status.closed .dot{background:var(--brass);box-shadow:0 0 0 4px rgba(233,180,76,.25)}
.hero h1{font-family:var(--display);font-weight:800;font-size:clamp(40px,5.6vw,70px);line-height:1;letter-spacing:-.03em;margin-bottom:22px;text-wrap:balance}
.hero .lead{font-size:20px;color:#D2E3EC;max-width:32ch;margin-bottom:30px}
.ticks{list-style:none;display:grid;gap:10px;color:#E8F1F5}
.ticks li{display:flex;gap:10px;align-items:center}
.ticks svg{color:var(--brass-hi)}

/* boarding pass */
.pass{display:grid;grid-template-columns:1fr 200px;background:#fff;color:var(--harbor);border-radius:20px;transform:rotate(-2deg);box-shadow:0 30px 60px -20px rgba(0,0,0,.55);animation:board 1s cubic-bezier(.2,.8,.2,1) .15s both}
@keyframes board{from{opacity:0;transform:translateY(40px) rotate(-6deg)}to{opacity:1;transform:rotate(-2deg)}}
@media (prefers-reduced-motion:reduce){.pass{animation:none}}
.pass-main{padding:26px 26px 22px}
.pass-head{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--harbor);padding-bottom:10px;margin-bottom:14px}
.pass-head b{font-family:var(--display);font-size:20px;font-weight:800;display:flex;align-items:center;gap:8px}
.pass-head span{font-size:13px;color:var(--lagoon);font-weight:700}
.route{display:flex;align-items:center;gap:12px;font-family:var(--display);font-weight:800;font-size:30px;margin:4px 0 16px;letter-spacing:-.01em}
.route i{flex:1;height:2px;background:repeating-linear-gradient(90deg,var(--lagoon) 0 8px,transparent 8px 14px);position:relative}
.route i::after{content:"";position:absolute;right:-2px;top:-4px;border-left:9px solid var(--lagoon);border-top:5px solid transparent;border-bottom:5px solid transparent}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px 18px}
.fields div:first-child{grid-column:1/-1}
.fields dt{font-size:12px;color:var(--muted)}
.fields dd{font-weight:600;font-size:15.5px;line-height:1.35}
.stub{background:var(--brass);border-radius:0 20px 20px 0;padding:22px 18px 18px;display:flex;flex-direction:column;justify-content:center;text-align:center;position:relative;border-left:2px dashed rgba(15,42,68,.45)}
.stub::before,.stub::after{content:"";position:absolute;left:-14px;width:26px;height:26px;border-radius:50%;background:var(--night)}
.stub::before{top:-13px}.stub::after{bottom:-13px}
.stub small{font-size:13px;font-weight:700}
.stub .num{font-family:var(--display);font-weight:800;font-size:22px;line-height:1.15;margin:8px 0 14px;word-break:break-word}
.barcode{height:34px;margin-top:14px;background:repeating-linear-gradient(90deg,var(--harbor) 0 2px,transparent 2px 4px,var(--harbor) 4px 7px,transparent 7px 9px,var(--harbor) 9px 10px,transparent 10px 13px);opacity:.85;border-radius:2px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--harbor);color:#fff;text-decoration:none;font-weight:700;padding:13px 18px;border-radius:12px;border:0;font-size:16px;font-family:var(--body);cursor:pointer;transition:background .15s}
.btn:hover{background:var(--deep)}
.stub .hours{font-size:12px;margin-top:10px;font-weight:600}

/* destinations */
.dests{display:grid;grid-template-columns:1.3fr 1fr 1fr;grid-template-rows:240px 240px;gap:16px}
.card{position:relative;border-radius:22px;overflow:hidden;color:#fff;text-decoration:none;display:flex;flex-direction:column;justify-content:flex-end;padding:22px;isolation:isolate}
.card::before{content:"";position:absolute;inset:0;z-index:-2;background:var(--img) center/cover no-repeat}
.card::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(8,26,43,0) 35%,rgba(8,26,43,.78))}
.card svg.art{position:absolute;inset:0;width:100%;height:100%;z-index:-2}
.card.has-photo svg.art{display:none}
.card h3{font-family:var(--display);font-size:28px;font-weight:800;letter-spacing:-.01em;line-height:1.05}
.card p{font-size:15px;color:#E3EEF3;margin-top:4px}
.card .ask{margin-top:12px;display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);padding:7px 12px;border-radius:999px;align-self:flex-start;transition:background .15s}
.card:hover .ask{background:var(--brass);color:var(--harbor);border-color:var(--brass)}
.card.big{grid-row:1/3}
.card.big h3{font-size:38px}

/* services */
.services-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;align-items:start}
.services-wrap .side p{color:var(--ink);margin-top:18px;max-width:42ch}
.services{list-style:none;border-top:2px solid var(--harbor)}
.services li{display:grid;grid-template-columns:48px 1fr;gap:18px;padding:24px 0;border-bottom:1px solid var(--line)}
.mark{width:48px;height:48px;border-radius:14px;background:var(--lagoon-soft);color:var(--lagoon);display:grid;place-items:center}
.services h3{font-family:var(--display);font-size:22px;font-weight:700;margin-bottom:4px}
.services p{color:var(--ink);max-width:56ch}

.lines{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:28px 0}
.lines p{font-size:16px;color:var(--ink);text-align:center}
.lines strong{color:var(--harbor)}

/* voyage steps */
.voyage{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:32px;list-style:none;margin-top:8px}
.voyage::before{content:"";position:absolute;top:26px;left:26px;right:26px;height:2px;background:repeating-linear-gradient(90deg,var(--lagoon) 0 10px,transparent 10px 18px)}
.voyage li{position:relative}
.port{width:54px;height:54px;border-radius:50%;background:var(--harbor);color:var(--brass);font-family:var(--display);font-weight:800;font-size:22px;display:grid;place-items:center;margin-bottom:20px;position:relative;border:5px solid var(--foam)}
.voyage h3{font-family:var(--display);font-size:23px;font-weight:700;margin-bottom:6px}
.voyage p{color:var(--ink);max-width:32ch}

/* reviews (hidden until real reviews are added) */
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.review{background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px}
.review blockquote{font-family:var(--display);font-size:19px;font-weight:500;line-height:1.4;margin-bottom:16px}
.review cite{font-style:normal;color:var(--muted);font-size:14px}

/* faq */
.faq-wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px}
details{border-bottom:1px solid var(--line);padding:20px 0}
details:first-of-type{border-top:2px solid var(--harbor)}
summary{cursor:pointer;list-style:none;font-family:var(--display);font-size:20px;font-weight:700;display:flex;justify-content:space-between;gap:20px;align-items:center}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-size:26px;color:var(--lagoon);font-weight:500;transition:transform .2s}
details[open] summary::after{transform:rotate(45deg)}
details p{color:var(--ink);margin-top:10px;max-width:62ch}

/* call-back */
.callback{background:var(--lagoon);color:#fff;position:relative;overflow:hidden}
.callback .wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:64px;align-items:start;position:relative}
.callback .side{color:#DDF2EF;margin-top:18px;max-width:38ch}
.callback .or{margin-top:30px;font-weight:600;color:#DDF2EF}
.callback .or a{color:#fff;font-family:var(--display);font-size:30px;font-weight:800;text-decoration:none;display:block;letter-spacing:-.01em}
form{background:#fff;color:var(--harbor);border-radius:22px;padding:30px;display:grid;gap:14px;box-shadow:0 24px 50px -24px rgba(8,26,43,.55)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
label{display:block;font-size:14px;font-weight:700;margin-bottom:5px}
input,select,textarea{width:100%;font:inherit;font-size:16px;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;background:var(--foam);color:var(--harbor)}
input:focus,select:focus,textarea:focus{border-color:var(--lagoon);outline:none;background:#fff}
form .btn{width:100%;padding:16px;font-size:17px}
.fine{font-size:13px;color:var(--muted)}

/* closing + footer */
.closing{background:var(--harbor);color:#fff;padding:80px 0;position:relative;overflow:hidden}
.closing .wrap{display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap}
.closing h2{max-width:16ch}
.closing .btn{background:var(--brass);color:var(--harbor);font-size:20px;padding:18px 30px;border-radius:14px}
.closing .btn:hover{background:var(--brass-hi)}
footer{background:var(--deep);color:#AFC5D3;padding:44px 0;font-size:14px}
.disclose{border:1px solid #2A4760;border-radius:14px;padding:16px 18px;margin-bottom:22px;color:#DCE8EF}
.disclose b{color:var(--brass-hi)}
footer nav{display:flex;flex-wrap:wrap;gap:18px;margin-top:14px}
footer a{color:#DCE8EF}

/* mobile call bar */
.callbar{position:fixed;left:12px;right:12px;bottom:12px;z-index:50;display:none;background:var(--brass);color:var(--harbor);text-decoration:none;font-weight:800;font-size:18px;padding:16px;border-radius:16px;align-items:center;justify-content:center;gap:10px;box-shadow:0 12px 30px -10px rgba(8,26,43,.6)}

@media (max-width:960px){
  .hero-grid,.services-wrap,.faq-wrap,.callback .wrap{grid-template-columns:1fr;gap:44px}
  .hero-grid{padding-top:130px;padding-bottom:150px}
  .pass{transform:none;animation:none;max-width:560px}
  .dests{grid-template-columns:1fr 1fr;grid-template-rows:auto}
  .card{min-height:220px}
  .card.big{grid-row:auto;grid-column:1/-1;min-height:280px}
  .reviews{grid-template-columns:1fr}
  .section-head{flex-direction:column;align-items:start}
  section{padding:72px 0}
}
@media (max-width:720px){
  .voyage{grid-template-columns:1fr;gap:28px}
  .voyage::before{top:26px;bottom:26px;left:26px;right:auto;width:2px;height:auto;background:repeating-linear-gradient(180deg,var(--lagoon) 0 10px,transparent 10px 18px)}
  .voyage li{padding-left:76px}
  .port{position:absolute;left:0;top:0;margin:0}
}
@media (max-width:600px){
  .top-call b{display:none}
  .pass{grid-template-columns:1fr}
  .stub{border-radius:0 0 20px 20px;border-left:0;border-top:2px dashed rgba(15,42,68,.45)}
  .stub::before,.stub::after{top:-14px;bottom:auto}
  .stub::before{left:-13px}.stub::after{left:auto;right:-13px}
  .fields{grid-template-columns:1fr}
  .dests{grid-template-columns:1fr}
  .row{grid-template-columns:1fr}
  .callbar{display:flex}
  .hero .lead{font-size:18px}
}
</style>
</head>
