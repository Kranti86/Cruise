<script>
  /* Set your real call-centre hours here (24h clock, US Eastern time). Days: 0 = Sunday ... 6 = Saturday */
  const HOURS = { open: 8, close: 23, days: [0,1,2,3,4,5,6], tz: "America/New_York" };

  (function () {
    try {
      const parts = new Intl.DateTimeFormat("en-US", { timeZone: HOURS.tz, hour: "numeric", hourCycle: "h23", weekday: "short" }).formatToParts(new Date());
      const hour = parseInt(parts.find(p => p.type === "hour").value, 10);
      const day = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"].indexOf(parts.find(p => p.type === "weekday").value);
      const open = HOURS.days.includes(day) && hour >= HOURS.open && hour < HOURS.close;
      if (!open) {
        document.getElementById("status").classList.add("closed");
        const t = document.getElementById("status-text");
        t.textContent = "We're closed right now. Request a call back";
        t.parentElement.style.cursor = "pointer";
        t.parentElement.onclick = () => document.getElementById("callback").scrollIntoView({ behavior: "smooth" });
      }
    } catch (e) {}
  })();
</script>

